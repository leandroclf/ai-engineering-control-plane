{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "controlplane": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AI Engineering Control Plane",
      "options": {
        "baseURL": "{env:LITELLM_BASE_URL}",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "coding-strong": { "name": "Coding Strong" },
        "coding-strong-openai": { "name": "Coding Strong — OpenAI" },
        "coding-strong-anthropic": { "name": "Coding Strong — Anthropic" },
        "coding-fast": { "name": "Coding Fast" },
        "coding-fast-openai": { "name": "Coding Fast — OpenAI" },
        "architecture": { "name": "Architecture" },
        "architecture-openai": { "name": "Architecture — OpenAI" },
        "architecture-anthropic": { "name": "Architecture — Anthropic" },
        "security": { "name": "Security" },
        "security-openai": { "name": "Security — OpenAI" },
        "security-anthropic": { "name": "Security — Anthropic" },
        "review": { "name": "Independent Review" },
        "review-openai": { "name": "Independent Review — OpenAI" },
        "review-anthropic": { "name": "Independent Review — Anthropic" }
      }
    }
  },
  "model": "controlplane/coding-strong",
  "permission": {
    "*": "deny",
    "read": { "*": "allow", "*.env": "deny", "*.env.*": "deny", "*.env.example": "allow" },
    "edit": "deny",
    "bash": { "*": "deny", "git status *": "allow", "git diff *": "allow", "git log *": "allow", "git commit *": "deny", "git push *": "deny" },
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "task": "deny",
    "skill": "deny",
    "doom_loop": "deny"
  }
}
