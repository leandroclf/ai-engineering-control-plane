AICP_STATE_DIR=./state
PROJECTS_DIR=./projects
NEO4J_AUTH=neo4j/change-me-before-start
AICP_GRAPH_ENABLED=false
LITELLM_MASTER_KEY=change-me-before-start
LITELLM_SALT_KEY=change-me-before-start
LITELLM_API_KEY=
MEMORY_SERVICE_TOKEN=change-me-before-start
MEMORY_SERVICE_PORT=18080
HARNESS_PORT=18081
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
MEMORY_AUTHORIZED_SCOPES=GLOBAL:local,ORGANIZATION:local,SOLUTION:local,PROJECT:local,REPOSITORY:site-lf-solucoes,REPOSITORY:ai-engineering-control-plane,AGENT:opencode,TASK:local,RUN:local,EXECUTION:local
CODING_STRONG_MODEL=openai/model-id
CODING_STRONG_SECONDARY_MODEL=anthropic/model-id
CODING_FAST_MODEL=openai/model-id
ARCHITECTURE_MODEL=openai/model-id
ARCHITECTURE_SECONDARY_MODEL=anthropic/model-id
SECURITY_MODEL=openai/model-id
SECURITY_SECONDARY_MODEL=anthropic/model-id
REVIEW_MODEL=anthropic/model-id
REVIEW_SECONDARY_MODEL=openai/model-id
SUMMARIZER_MODEL=openai/model-id
EMBEDDING_MODEL=openai/model-id
AICP_OPENAI_STRONG_INPUT_PRICE=
AICP_OPENAI_STRONG_OUTPUT_PRICE=
AICP_OPENAI_FAST_INPUT_PRICE=
AICP_OPENAI_FAST_OUTPUT_PRICE=
AICP_OPENAI_EMBEDDING_INPUT_PRICE=
AICP_OPENAI_EMBEDDING_OUTPUT_PRICE=0
AICP_ANTHROPIC_STRONG_INPUT_PRICE=
AICP_ANTHROPIC_STRONG_OUTPUT_PRICE=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Agent Provider Layer: disabled preserves Harness -> OpenCode -> LiteLLM.
AICP_AGENT_PROVIDER_LAYER_ENABLED=false
AICP_AGENT_PROVIDER_DEFAULT=opencode-litellm
AICP_CODEX_PROVIDER_ENABLED=false
AICP_CLAUDE_CODE_PROVIDER_ENABLED=false
AICP_PROVIDER_FALLBACK_ENABLED=false
AICP_SUBSCRIPTION_PROVIDERS_LOCAL_ONLY=true
AICP_SUBSCRIPTION_PROVIDERS_CI_ENABLED=false
AICP_LIVE_PROVIDER_TESTS=false
AICP_ENVIRONMENT_CLASS=LOCAL_PERSONAL
AICP_PROVIDER_MAX_OUTPUT_BYTES=2097152
