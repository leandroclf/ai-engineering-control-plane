{
  "name": "ai-engineering-control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/unit/*.test.mjs",
    "test:python": "PYTHONPATH=memory-service/src python3 -m unittest discover -s tests/unit -p '*_test.py'",
    "test:acceptance": "bash tests/acceptance/config_test.sh && bash tests/acceptance/harness_test.sh",
    "validate": "npm test && npm run test:python && npm run test:acceptance"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.18.21"
  }
}
