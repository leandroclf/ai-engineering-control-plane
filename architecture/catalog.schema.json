{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "components"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "title": { "type": "string" },
    "components": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "plane", "purpose", "why", "benefits", "authority", "owns", "doesNotOwn", "state", "dataSensitivity", "dependencies", "interfaces", "failureMode", "securityBoundary", "observability", "docs"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "name": { "type": "string" },
          "plane": { "enum": ["human", "control", "execution", "knowledge", "data", "external"] },
          "purpose": { "type": "string" }, "why": { "type": "string" }, "benefits": { "type": "array", "items": { "type": "string" } },
          "authority": { "type": "string" }, "owns": { "type": "array", "items": { "type": "string" } }, "doesNotOwn": { "type": "array", "items": { "type": "string" } },
          "state": { "type": "object" }, "dataSensitivity": { "type": "string" }, "dependencies": { "type": "array", "items": { "type": "string" } },
          "interfaces": { "type": "array", "items": { "type": "string" } }, "failureMode": { "enum": ["fail-closed", "degraded-read-only", "retryable"] },
          "securityBoundary": { "type": "string" }, "observability": { "type": "array", "items": { "type": "string" } }, "docs": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
